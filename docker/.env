# BASE_EMAIL_USE_TLS={{ colander_vault.email_use_tls }}
BASE_EMAIL_USE_TLS=False
# BASE_EMAIL_USE_SSL={{ colander_vault.email_use_ssl }}
BASE_EMAIL_USE_SSL=False
# BASE_LICENSE_ENABLED=True
BASE_LICENSE_ENABLED=True
# BASE_USE_MANDOLIN={{ flavor.use_mandolin }}
BASE_USE_MANDOLIN=True
# BASE_USE_CYBERCHEF={{ flavor.use_cyberchef }}
BASE_USE_CYBERCHEF=True
# BASE_USE_THREATR={{ flavor.use_threatr }}
BASE_USE_THREATR=True
# BASE_USE_PLAYWRIGHT={{ flavor.use_playwright }}
BASE_USE_PLAYWRIGHT=True


COLANDER_REDIS_URL=redis://redis:6379/0
COLANDER_DJANGO_SECURE_SSL_REDIRECT=False
COLANDER_DJANGO_ACCOUNT_ALLOW_REGISTRATION=False
COLANDER_DJANGO_SETTINGS_MODULE=config.settings.production
COLANDER_WEB_CONCURRENCY=4
