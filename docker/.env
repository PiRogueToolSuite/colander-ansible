BASE_CYBERCHEF_BASE_URL=http://cyberchef.local
# BASE_ACME_EMAIL={{ colander_vault.acme_email }}
BASE_ACME_EMAIL=admin@local.host
# BASE_ADMIN_NAME={{ colander_vault.admin_name }}
BASE_ADMIN_NAME=admin
# BASE_ADMIN_EMAIL={{ colander_vault.admin_email }}
