#!/usr/bin/env bash

set -o errexit
set -o pipefail
set -o nounset

backup_storage_path="{{ docker_backup_path }}"
backup_dir="${backup_storage_path}/${1}"

if [[ -z ${1+x} ]]; then
    echo -e "\e[31mERROR\e[0m Backup filename is not specified yet it is a required parameter. Make sure you provide one and try again (e.g., 2025_02_20-14_53_32)."
    exit 1
fi
if [[ ! -d "${backup_dir}" ]]; then
    echo -e "\e[31mERROR\e[0m No backup with the specified filename found. Check out the 'backup' maintenance script."
    exit 1
fi

# Check all required backup files exist
if [ -z "$( ls -A "${backup_dir}/colander-db" )" ]; then
    echo -e "\e[31mERROR\e[0m No backup found for colander-db."
    exit 1
fi

{% if flavor.use_threatr %}
if [ -z "$( ls -A "${backup_dir}/threatr-db" )" ]; then
    echo -e "\e[31mERROR\e[0m No backup found for threatr-db."
    exit 1
fi
{% endif %}

if [ -z "$( ls -A "${backup_dir}/rustfs" )" ]; then
    echo -e "\e[31mERROR\e[0m No backup found for rustfs."
    exit 1
fi

if [ -z "$( ls -A "${backup_dir}/elasticsearch" )" ]; then
    echo -e "\e[31mERROR\e[0m No backup found for elasticsearch."
    exit 1
fi

# Restore Postgres databases
colander_db_volume_path="{{ stack.services.colander_postgres.volumes.backups }}"
rm -rf ${colander_db_volume_path}/*
cp ${backup_dir}/colander-db/* ${colander_db_volume_path}/
backup_file=$(ls -t ${backup_dir}/colander-db/*.gz | head -n1)
backup_filename="${backup_filepath##*/}"
docker compose -f "{{ colander_installation_path }}/compose/{{ compose_file }}" run --rm colander-postgres restore ${backup_filename}
rm -rf ${colander_db_volume_path}/*

{% if flavor.use_threatr %}
threatr_db_volume_path="{{ stack.services.threatr_postgres.volumes.backups }}"
rm -rf ${threatr_db_volume_path}/*
cp ${backup_dir}/threatr-db/* ${threatr_db_volume_path}/
backup_file=$(ls -t ${backup_dir}/threatr-db/*.gz | head -n1)
backup_filename="${backup_filepath##*/}"
docker compose -f "{{ colander_installation_path }}/compose/{{ compose_file }}" run --rm threatr-postgres restore ${backup_filename}
rm -rf ${threatr_db_volume_path}/*
{% endif %}

# Restore RustFS
backup_filepath=$(ls -t ${backup_dir}/rustfs/*.tgz | head -n1)
backup_filename="${backup_filepath##*/}"
docker compose -f "{{ colander_installation_path }}/compose/{{ compose_file }}" cp "$backup_filepath" rustfs:/data/
# this chown command should be kept aligned with the one in fix_permissions_to_migrate_from_minio_to_rustfs
docker compose -f "{{ colander_installation_path }}/compose/{{ compose_file }}" exec --user root rustfs /bin/sh -c "rm -Rf /data/local-media/* && tar xzf /data/$backup_filename -C /data/ && rm -Rf /data/$backup_filename"
docker compose -f "{{ colander_installation_path }}/compose/{{ compose_file }}" up -d fix_permissions_to_migrate_from_minio_to_rustfs # changes ownership of /data to rustfs

# Restore Elasticsearch
backup_filepath=$(ls -t ${backup_dir}/elasticsearch/*.tgz | head -n1)
backup_filename="${backup_filepath##*/}"
snapshot_name=$(tar -xOf $backup_filepath index-0 | jq '.snapshots[0].name')
docker compose -f "{{ colander_installation_path }}/compose/{{ compose_file }}" cp "$backup_filepath" elasticsearch:/usr/share/elasticsearch/data/
docker compose -f "{{ colander_installation_path }}/compose/{{ compose_file }}" exec elasticsearch /bin/bash -c "rm -Rf /usr/share/elasticsearch/data/snapshots/* && tar xzf /usr/share/elasticsearch/data/$backup_filename -C /usr/share/elasticsearch/data/snapshots && rm -f /usr/share/elasticsearch/data/$backup_filename && curl -s -X POST http://localhost:9200/_snapshot/snapshots/${snapshot_name}/_restore"


echo "(Re)starting all services"
docker compose -f "{{ colander_installation_path }}/compose/{{ compose_file }}" up -d
